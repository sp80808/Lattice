{
  "mode": "auto",
  "autonomy": { "mode": "supervised" },
  "model": {
    "provider": "openai-compatible",
    "baseUrl": "https://api.example.com/v1",
    "model": "your-model-name",
    "apiKeyEnv": "LATTICE_API_KEY"
  },
  "agent": { "preset": "opencode", "format": "json", "autoApprove": false },
