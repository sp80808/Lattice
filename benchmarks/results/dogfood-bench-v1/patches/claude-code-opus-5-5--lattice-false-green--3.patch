index 0000000..400ac67
--- /dev/null
+++ b/scripts/run-node-tests.mjs
@@ -0,0 +1,59 @@
+#!/usr/bin/env node
+// Run node:test files and fail on anything that is not a real pass.
+//
+//   node scripts/run-node-tests.mjs <file>...
+//
+// `node --test` exits 0 when tests are skipped or marked todo, so a suite that
+// silently stopped verifying anything still looks green. Here every failed,
+// cancelled, skipped or todo test fails the run, unless its name is listed in
+// $LATTICE_ALLOW_SKIPPED_TESTS (comma-separated; applies to skip/todo only).
+import { existsSync } from "node:fs";
+import { run } from "node:test";
+import { spec } from "node:test/reporters";
+
+const files = process.argv.slice(2);
+if (files.length === 0) {
+  console.error("usage: node scripts/run-node-tests.mjs <file>...");
+  process.exit(2);
+}
+const missing = files.filter((file) => !existsSync(file));
+if (missing.length > 0) {
+  console.error(`test files not found (run npm run build first): ${missing.join(", ")}`);
+  process.exit(1);
+}
+
+const allowed = new Set(
+  (process.env.LATTICE_ALLOW_SKIPPED_TESTS ?? "")
+    .split(",")
+    .map((name) => name.trim())
+    .filter(Boolean),
+);
+
+const problems = [];
+let passed = 0;
+const stream = run({ files });
+stream.on("test:pass", (data) => {
+  if (data.details?.type === "suite") return;
+  if (data.skip !== undefined || data.todo !== undefined) {
+    const kind = data.skip !== undefined ? "skipped" : "todo";
+    if (!allowed.has(data.name)) problems.push(`${kind}: ${data.name} (${data.file ?? "?"})`);
+  } else {
+    passed++;
+  }
+});
+stream.on("test:fail", (data) => {
+  const kind = data.details?.error?.failureType === "cancelledByParent" ? "cancelled" : "failed";
+  problems.push(`${kind}: ${data.name} (${data.file ?? "?"})`);
+});
+stream.compose(spec).pipe(process.stdout);
+
+await new Promise((resolve) => stream.once("end", resolve));
+
+if (problems.length > 0) {
+  console.error(`\n${problems.length} test(s) did not pass:`);
+  for (const problem of problems) console.error(`  - ${problem}`);
+  process.exitCode = 1;
+} else if (passed === 0) {
+  console.error("\nno tests ran");
+  process.exitCode = 1;
+}
diff --git a/scripts/run-python-tests.py b/scripts/run-python-tests.py
new file mode 100755
index 0000000..b215c45
--- /dev/null
+++ b/scripts/run-python-tests.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Run the Python SDK tests and fail on anything that is not a real pass.
+
+    python3 scripts/run-python-tests.py
+
+`unittest` reports OK when tests are skipped (e.g. the CLI is not built), so a
+suite that verified nothing still looks green. Skipped tests and expected
+failures fail the run unless their test ID is listed in
+$LATTICE_ALLOW_SKIPPED_TESTS (comma-separated).
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main() -> int:
+    allowed = {name.strip() for name in os.environ.get("LATTICE_ALLOW_SKIPPED_TESTS", "").split(",") if name.strip()}
+    suite = unittest.defaultTestLoader.discover(str(ROOT / "sdks" / "python" / "tests"))
+    result = unittest.TextTestRunner(verbosity=2).run(suite)
+
+    problems = [f"skipped: {test.id()} ({reason})" for test, reason in result.skipped if test.id() not in allowed]
+    problems += [f"expected failure: {test.id()}" for test, _ in result.expectedFailures if test.id() not in allowed]
+    problems += [f"unexpected success: {test.id()}" for test in result.unexpectedSuccesses]
+    if problems:
+        print(f"\n{len(problems)} test(s) did not really pass:", file=sys.stderr)
+        for problem in problems:
+            print(f"  - {problem}", file=sys.stderr)
+    if result.testsRun == 0:
+        print("\nno tests ran", file=sys.stderr)
+        return 1
+    return 0 if result.wasSuccessful() and not problems else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
