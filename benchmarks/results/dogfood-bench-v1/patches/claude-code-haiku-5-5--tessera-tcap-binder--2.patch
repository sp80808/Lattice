+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::graph::{Node, NodeId};
+    use tessera_tir::TirModule;
+
+    fn func(text: &str) -> TirFunction {
+        TirModule::parse(text)
+            .expect("test TIR parses")
+            .funcs
+            .remove(0)
+    }
+
+    /// Stable label for the place an event touches: `arg#i` for parameters,
+    /// `local name@id` for `let` locals (ids are assigned in derivation order).
+    fn place_label(graph: &CapabilityGraph, node: NodeId) -> String {
+        match graph.nodes().get(&node) {
+            Some(Node::Place(PlaceNode::Remote { arg_index, .. })) => format!("arg#{arg_index}"),
+            Some(Node::Place(PlaceNode::Local { id, name, .. })) => format!("local {name}{id}"),
+            other => panic!("edge endpoint is not a place: {other:?}"),
+        }
+    }
+
+    /// One line per edge in emission order: `kind place before->after`.
+    fn events(graph: &CapabilityGraph) -> Vec<String> {
+        graph
+            .edges()
+            .iter()
+            .map(|edge| {
+                format!(
+                    "{} {} {}->{}",
+                    edge.kind,
+                    place_label(graph, edge.from),
+                    edge.before_state.capability,
+                    edge.after_state.capability
+                )
+            })
+            .collect()
+    }
+
+    fn derive_with_tcap(text: &str) -> Vec<String> {
+        events(&derive_tcap(&func(text)))
+    }
+
+    fn derive_with_borrowing(text: &str) -> Vec<String> {
+        events(&BorrowingDeriver::new().derive(&func(text)))
+    }
+
+    /// Both derivation paths must emit the same events for the same function.
+    fn assert_paths_agree(text: &str) -> Vec<String> {
+        let tcap = derive_with_tcap(text);
+        let borrowing = derive_with_borrowing(text);
+        assert_eq!(tcap, borrowing, "derivation paths disagree for {text}");
+        tcap
+    }
+
+    #[test]
+    fn each_parameter_read_targets_its_own_remote() {
+        let events = assert_paths_agree(
+            "(func f (param a i64) (param b i64) (param c i64) (return i64) \
+             (body (add i64 (add i64 (var c i64) (var a i64)) (var b i64))))",
+        );
+        assert_eq!(
+            events,
+            ["read arg#2 E->E", "read arg#0 E->E", "read arg#1 E->E",]
+        );
+    }
+
+    #[test]
+    fn parameter_reads_in_calls_and_branches_resolve_by_name() {
+        let events = assert_paths_agree(
+            "(func f (param a i64) (param b i64) (return i64) \
+             (body (if i64 (eq (var b i64) (int 0 i64)) (var a i64) (call g i64 (var b i64)))))",
+        );
+        assert_eq!(
+            events,
+            ["read arg#1 E->E", "read arg#0 E->E", "read arg#1 E->E",]
+        );
+    }
+
+    #[test]
+    fn let_shadowing_a_parameter_selects_the_local_inside_its_body() {
+        let events = assert_paths_agree(
+            "(func f (param x i64) (return i64) \
+             (body (add i64 (let x i64 (int 1 i64) (var x i64)) (var x i64))))",
+        );
+        assert_eq!(
+            events,
+            [
+                "read local x@2 E->E",
+                "drop local x@2 E->0",
+                "read arg#0 E->E",
+            ]
+        );
+    }
+
+    #[test]
+    fn nested_let_shadowing_selects_the_innermost_place() {
+        let events = assert_paths_agree(
+            "(func f (return i64) \
+             (body (let x i64 (int 1 i64) (let x i64 (int 2 i64) (var x i64)))))",
+        );
+        assert_eq!(
+            events,
+            [
+                "read local x@2 E->E",
+                "drop local x@2 E->0",
+                "drop local x@1 E->0",
+            ]
+        );
+    }
+
+    #[test]
+    fn let_initializer_sees_the_outer_binding() {
+        let events = assert_paths_agree(
+            "(func f (param x i64) (return i64) \
+             (body (let x i64 (add i64 (var x i64) (int 1 i64)) (var x i64))))",
+        );
+        assert_eq!(
+            events,
+            [
+                "read arg#0 E->E",
+                "read local x@2 E->E",
+                "drop local x@2 E->0",
+            ]
+        );
+    }
+
+    #[test]
+    fn locals_drop_at_their_scope_exit_not_at_function_end() {
+        let events = assert_paths_agree(
+            "(func f (param a i64) (return i64) \
+             (body (add i64 (let y i64 (int 1 i64) (var y i64)) (var a i64))))",
+        );
+        assert_eq!(
+            events,
+            [
+                "read local y@2 E->E",
+                "drop local y@2 E->0",
+                "read arg#0 E->E",
+            ]
+        );
+    }
+
+    #[test]
+    fn nested_locals_drop_in_reverse_declaration_order() {
+        let events = assert_paths_agree(
+            "(func f (return i64) \
+             (body (let a i64 (int 1 i64) (let b i64 (int 2 i64) \
+             (add i64 (var a i64) (var b i64))))))",
+        );
+        assert_eq!(
+            events,
+            [
+                "read local a@1 E->E",
+                "read local b@2 E->E",
+                "drop local b@2 E->0",
+                "drop local a@1 E->0",
+            ]
+        );
+    }
+
+    #[test]
+    fn sibling_lets_with_the_same_name_get_distinct_places() {
+        let events = assert_paths_agree(
+            "(func f (return i64) \
+             (body (add i64 (let t i64 (int 1 i64) (var t i64)) \
+             (let t i64 (int 2 i64) (var t i64)))))",
+        );
+        assert_eq!(
+            events,
+            [
+                "read local t@1 E->E",
+                "drop local t@1 E->0",
+                "read local t@2 E->E",
+                "drop local t@2 E->0",
+            ]
+        );
+    }
+}
