 #!/usr/bin/env bash
 # Run every offline example and validate every example config. Used by CI.
+#
+# Exits non-zero if any example fails, and never prints the overall success
+# line after a failure. A skipped example is also a failure unless it is named
+# in CHECK_EXAMPLES_ALLOW_SKIP (comma-separated, e.g. "sdk-python").
 set -euo pipefail
 . "$(dirname "$0")/lib.sh"
 
+ALLOW_SKIP=",${CHECK_EXAMPLES_ALLOW_SKIP:-},"
+LOG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/lattice-examples.XXXXXX")"
+trap 'rm -rf "$LOG_DIR"' EXIT
+
+PASSED=0 FAILED=() SKIPPED=()
+
+# Run one example. Its output goes to a log that is shown only on failure.
+example() {
+  local name="$1" label="$2" status=0
+  shift 2
+  info "$name"
+  "$@" >"$LOG_DIR/$name.log" 2>&1 || status=$?
+  if [ "$status" = 0 ]; then
+    ok "$label"
+    PASSED=$((PASSED + 1))
+  else
+    tail -n 40 "$LOG_DIR/$name.log" >&2
+    warn "$name exited with status $status"
+    FAILED+=("$name")
+  fi
+}
+
+# Record a skipped example. Only an allow-listed skip is accepted.
+skip() {
+  local name="$1" reason="$2"
+  if [[ "$ALLOW_SKIP" == *",$name,"* ]]; then
+    warn "$name skipped: $reason (allow-listed via CHECK_EXAMPLES_ALLOW_SKIP)"
+    SKIPPED+=("$name")
+  else
+    warn "$name skipped: $reason"
+    FAILED+=("$name (skipped: $reason; allow-list it in CHECK_EXAMPLES_ALLOW_SKIP to accept)")
+  fi
+}
+
 require_node
 require_built_cli
 cd "$LATTICE_ROOT"
 
 info "Validating examples/configs/*.json"
