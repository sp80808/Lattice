+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::graph::{EdgeKind, Node};
+    use tessera_tir::TirModule;
+
+    /// One line per read/drop edge, in graph order, naming the place it touches:
+    /// `read remote arg#1`, `read local x#2`, `drop local x#2`.
+    fn access_trace(graph: &CapabilityGraph) -> Vec<String> {
+        graph
+            .edges()
+            .iter()
+            .filter(|e| matches!(e.kind, EdgeKind::Read | EdgeKind::Drop))
+            .map(|e| {
+                let Some(Node::Place(place)) = graph.nodes().get(&e.from) else {
+                    panic!("access edge {} has no place source", e.id);
+                };
+                let target = match place {
+                    PlaceNode::Remote { arg_index, .. } => format!("remote arg#{arg_index}"),
+                    PlaceNode::Local { id, name, .. } => format!("local {name}#{}", id.0),
+                    other => panic!("unexpected place {other:?}"),
+                };
+                format!("{} {target}", e.kind.as_str())
+            })
+            .collect()
+    }
+
+    /// Derive `f` through both paths and assert they produce the same accesses.
+    fn trace_of(text: &str) -> Vec<String> {
+        let module = TirModule::parse(text).expect("fixture parses");
+        let func = module.function("f").expect("fixture defines f");
+        let tcap = access_trace(&derive_tcap(func));
+        let borrowing = access_trace(&BorrowingDeriver::new().derive(func));
+        assert_eq!(tcap, borrowing, "derivation paths disagree");
+        tcap
+    }
+
+    #[test]
+    fn param_reads_bind_by_name_not_position() {
+        let trace = trace_of(
+            "(func f (param a i64) (param b i64) (return i64) \
+               (body (add i64 (var b i64) (var a i64))))",
+        );
+        assert_eq!(trace, ["read remote arg#1", "read remote arg#0"]);
+    }
+
+    #[test]
+    fn let_shadows_param_only_inside_its_body() {
+        // The initializer still sees the parameter; the body sees the local;
+        // after the body the parameter is visible again.
+        let trace = trace_of(
+            "(func f (param x i64) (return i64) \
+               (body (add i64 (let x i64 (var x i64) (var x i64)) (var x i64))))",
+        );
+        assert_eq!(
+            trace,
+            [
+                "read remote arg#0",
+                "read local x#2",
+                "drop local x#2",
+                "read remote arg#0",
+            ]
+        );
+    }
+
+    #[test]
+    fn nested_let_reads_innermost_binding() {
+        let trace = trace_of(
+            "(func f (return i64) \
+               (body (let x i64 (int 1 i64) \
+                 (add i64 (let x i64 (int 10 i64) (var x i64)) (var x i64)))))",
+        );
+        assert_eq!(
+            trace,
+            [
+                "read local x#2",
+                "drop local x#2",
+                "read local x#1",
+                "drop local x#1",
+            ]
+        );
+    }
+
+    #[test]
+    fn let_initializer_sees_outer_binding() {
+        let trace = trace_of(
+            "(func f (return i64) \
+               (body (let x i64 (int 1 i64) \
+                 (let x i64 (add i64 (var x i64) (int 1 i64)) (var x i64)))))",
+        );
+        assert_eq!(
+            trace,
+            [
+                "read local x#1",
+                "read local x#2",
+                "drop local x#2",
+                "drop local x#1",
+            ]
+        );
+    }
+
+    #[test]
+    fn nested_locals_drop_innermost_first() {
+        let trace = trace_of(
+            "(func f (return i64) \
+               (body (let a i64 (int 1 i64) \
+                 (let b i64 (var a i64) (var b i64)))))",
+        );
+        assert_eq!(
+            trace,
+            [
+                "read local a#1",
+                "read local b#2",
+                "drop local b#2",
+                "drop local a#1",
+            ]
+        );
+    }
+
+    #[test]
+    fn local_drops_at_its_scope_exit_not_function_end() {
+        let trace = trace_of(
+            "(func f (param y i64) (return i64) \
+               (body (add i64 (let x i64 (int 1 i64) (var x i64)) (var y i64))))",
+        );
+        assert_eq!(
+            trace,
+            ["read local x#2", "drop local x#2", "read remote arg#0"]
+        );
+    }
+
+    #[test]
+    fn derivation_paths_agree_across_if_branches() {
+        let trace = trace_of(
+            "(func f (param c bool) (param n i64) (return i64) \
+               (body (if i64 (var c bool) \
+                 (let n i64 (int 0 i64) (var n i64)) \
+                 (var n i64))))",
+        );
+        assert_eq!(
+            trace,
+            [
+                "read remote arg#0",
+                "read local n#3",
+                "drop local n#3",
+                "read remote arg#1",
+            ]
+        );
+    }
+}
