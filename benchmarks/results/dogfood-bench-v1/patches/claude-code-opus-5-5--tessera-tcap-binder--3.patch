+/// Lexical binder environment shared by both TCap derivation paths, so they
+/// resolve variable reads and drop locals by the same rules:
+///
+/// - each parameter is a `Remote` place bound by its own name;
+/// - each `Let` binds a fresh `Local` place for the extent of its body, and a
+///   `Var` resolves to the innermost binder of that name;
+/// - a `Let`'s local is dropped when its body's scope exits.
+struct BinderEnv {
+    scopes: Vec<(String, PlaceId)>,
+    next_place_id: u32,
+}
+
+impl BinderEnv {
+    fn new() -> Self {
+        Self {
+            scopes: Vec::new(),
+            next_place_id: 1,
+        }
+    }
+
+    fn fresh_place_id(&mut self) -> PlaceId {
+        let id = PlaceId(self.next_place_id);
+        self.next_place_id += 1;
+        id
+    }
+
+    /// Create one `Remote` place per parameter, bound by the parameter name.
+    fn bind_params(&mut self, system: &mut TransitionSystem, func: &TirFunction) -> Vec<PlaceNode> {
+        let mut places = Vec::with_capacity(func.params.len());
+        for (i, param) in func.params.iter().enumerate() {
+            let place = PlaceNode::Remote {
+                id: self.fresh_place_id(),
+                arg_index: i,
+                ty: tir_type_to_place_type(param.ty),
+            };
+            system.graph_mut().add_place(place.clone());
+            // Parameters start as Exclusive (owned by caller, borrowed by callee)
+            system
+                .graph_mut()
+                .set_state(place.id(), CapabilityState::exclusive());
+            self.scopes.push((param.name.clone(), place.id()));
+            places.push(place);
+        }
+        places
+    }
+
+    /// Enter a `Let` scope: bind `name` to a fresh `Local` place.
+    fn enter_let(&mut self, system: &mut TransitionSystem, name: &str, ty: TirType) -> PlaceNode {
+        let place = PlaceNode::Local {
+            id: self.fresh_place_id(),
+            name: name.to_string(),
+            ty: tir_type_to_place_type(ty),
+        };
+        system.graph_mut().add_place(place.clone());
+        self.scopes.push((name.to_string(), place.id()));
+        place
+    }
+
+    /// Exit the innermost `Let` scope and drop its local.
+    fn exit_let(&mut self, system: &mut TransitionSystem, name: &str) {
+        let (bound, place) = self
+            .scopes
+            .pop()
+            .expect("exit_let without a matching enter_let");
+        debug_assert_eq!(bound, name);
+        let _ = system.execute_drop(place, Span::dummy(), format!("drop {name}"));
+    }
+
+    /// Resolve `name` to the place of its innermost binder.
+    fn resolve(&self, name: &str) -> Option<PlaceId> {
+        self.scopes
+            .iter()
+            .rev()
+            .find(|(bound, _)| bound == name)
+            .map(|(_, place)| *place)
+    }
+
+    /// Read the place `name` resolves to. Unbound names (rejected by the TIR
+    /// verifier) produce no edge.
+    fn read(&self, system: &mut TransitionSystem, name: &str) {
+        if let Some(place) = self.resolve(name) {
+            let _ = system.execute_read(place, Span::dummy(), format!("read {name}"));
+        }
+    }
+}
+
+fn tir_type_to_place_type(ty: TirType) -> PlaceType {
+    match ty {
+        TirType::I64 | TirType::Bool => PlaceType::Scalar,
+    }
+}
