+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::graph::{EdgeKind, Node};
+    use tessera_tir::TirParam;
+
+    fn var(name: &str) -> TirExpr {
+        TirExpr::Var {
+            name: name.to_string(),
+            ty: TirType::I64,
+        }
+    }
+
+    fn int(value: i64) -> TirExpr {
+        TirExpr::Int {
+            value,
+            ty: TirType::I64,
+        }
+    }
+
+    fn add(lhs: TirExpr, rhs: TirExpr) -> TirExpr {
+        TirExpr::Add {
+            lhs: Box::new(lhs),
+            rhs: Box::new(rhs),
+            ty: TirType::I64,
+        }
+    }
+
+    fn let_(name: &str, init: TirExpr, body: TirExpr) -> TirExpr {
+        TirExpr::Let {
+            name: name.to_string(),
+            ty: TirType::I64,
+            init: Box::new(init),
+            body: Box::new(body),
+        }
+    }
+
+    fn func(params: &[&str], body: TirExpr) -> TirFunction {
+        TirFunction {
+            name: "f".to_string(),
+            params: params
+                .iter()
+                .map(|name| TirParam {
+                    name: (*name).to_string(),
+                    ty: TirType::I64,
+                })
+                .collect(),
+            ret: TirType::I64,
+            body,
+        }
+    }
+
+    /// Edge trace as `kind place_id place` strings, in emission order.
+    fn trace(graph: &CapabilityGraph) -> Vec<String> {
+        graph
+            .edges()
+            .iter()
+            .map(|edge| match graph.nodes().get(&edge.from) {
+                Some(Node::Place(place)) => {
+                    format!("{} #{} {place}", edge.kind, place.id().0)
+                }
+                other => panic!("edge {:?} not on a place: {other:?}", edge.kind),
+            })
+            .collect()
+    }
+
+    /// Run both derivation paths and require they agree on the trace.
+    fn derive_both(func: &TirFunction) -> Vec<String> {
+        let plain = trace(&derive_tcap(func));
+        let borrowing = trace(&BorrowingDeriver::new().derive(func));
+        assert_eq!(plain, borrowing, "TCap derivation paths disagree");
+        plain
+    }
+
+    #[test]
+    fn each_param_read_targets_its_own_remote() {
+        let f = func(&["a", "b", "c"], add(var("c"), add(var("a"), var("b"))));
+        assert_eq!(
+            derive_both(&f),
+            [
+                "read #3 remote arg#2",
+                "read #1 remote arg#0",
+                "read #2 remote arg#1",
+            ]
+        );
+    }
+
+    #[test]
+    fn nested_let_shadowing_selects_innermost_place() {
+        // (let x 1 (add (let x 2 (var x)) (var x)))
+        let f = func(
+            &[],
+            let_("x", int(1), add(let_("x", int(2), var("x")), var("x"))),
+        );
+        assert_eq!(
+            derive_both(&f),
+            [
+                "read #2 local x",
+                "drop #2 local x",
+                "read #1 local x",
+                "drop #1 local x",
+            ]
+        );
+    }
+
+    #[test]
+    fn let_shadowing_a_param_is_scoped_to_its_body() {
+        // (add (let a (var a) (var a)) (var a))
+        let f = func(&["a"], add(let_("a", var("a"), var("a")), var("a")));
+        assert_eq!(
+            derive_both(&f),
+            [
+                // init is outside the binder's scope: reads the parameter.
+                "read #1 remote arg#0",
+                "read #2 local a",
+                "drop #2 local a",
+                "read #1 remote arg#0",
+            ]
+        );
+    }
+
+    #[test]
+    fn locals_drop_at_their_own_scope_exit() {
+        // (add (let x (var p) (var x)) (let y 3 (add (var y) (var p))))
+        let f = func(
+            &["p"],
+            add(
+                let_("x", var("p"), var("x")),
+                let_("y", int(3), add(var("y"), var("p"))),
+            ),
+        );
+        assert_eq!(
+            derive_both(&f),
+            [
+                "read #1 remote arg#0",
+                "read #2 local x",
+                "drop #2 local x",
+                "read #3 local y",
+                "read #1 remote arg#0",
+                "drop #3 local y",
+            ]
+        );
+        // Params are never dropped by the callee.
+        let graph = derive_tcap(&f);
+        assert!(
+            graph
+                .edges()
+                .iter()
+                .filter(|e| e.kind == EdgeKind::Drop)
+                .all(|e| matches!(
+                    graph.nodes().get(&e.from),
+                    Some(Node::Place(PlaceNode::Local { .. }))
+                ))
+        );
+    }
+
+    #[test]
+    fn derivation_is_deterministic() {
+        let f = func(
+            &["a", "b"],
+            let_("t", add(var("b"), var("a")), add(var("t"), var("b"))),
+        );
+        let first = derive_both(&f);
+        for _ in 0..8 {
+            assert_eq!(derive_both(&f), first);
+        }
+    }
+}
