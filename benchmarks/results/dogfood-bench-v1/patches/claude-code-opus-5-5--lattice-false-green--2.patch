+/**
+ * The environment for an executed command. NODE_TEST_CONTEXT is set by Node's
+ * test runner for its child processes; a nested `node --test` that inherits it
+ * reports to the parent instead of exiting non-zero on failures, which would
+ * turn a failing verifier into false success evidence. Callers may still set
+ * it explicitly via `spec.env`.
+ */
+function commandEnv(overrides: CommandSpec["env"]): NodeJS.ProcessEnv {
+  const { NODE_TEST_CONTEXT: _testContext, ...inherited } = process.env;
+  return { ...inherited, ...overrides };
+}
