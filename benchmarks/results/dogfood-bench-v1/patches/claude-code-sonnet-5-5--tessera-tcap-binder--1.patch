+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::graph::{EdgeKind, Node};
+    use tessera_tir::TirParam;
+
+    fn var(name: &str) -> TirExpr {
+        TirExpr::Var {
+            name: name.into(),
+            ty: TirType::I64,
+        }
+    }
+
+    fn let_(name: &str, init: TirExpr, body: TirExpr) -> TirExpr {
+        TirExpr::Let {
+            name: name.into(),
+            ty: TirType::I64,
+            init: Box::new(init),
+            body: Box::new(body),
+        }
+    }
+
+    fn add(lhs: TirExpr, rhs: TirExpr) -> TirExpr {
+        TirExpr::Add {
+            ty: TirType::I64,
+            lhs: Box::new(lhs),
+            rhs: Box::new(rhs),
+        }
+    }
+
+    fn func(body: TirExpr) -> TirFunction {
+        TirFunction {
+            name: "f".into(),
+            params: ["a", "b", "c"]
+                .iter()
+                .map(|n| TirParam {
+                    name: (*n).into(),
+                    ty: TirType::I64,
+                })
+                .collect(),
+            ret: TirType::I64,
+            body,
+        }
+    }
+
+    /// Describe the place touched by each edge of `kind`, in order.
+    fn touched(g: &CapabilityGraph, kind: EdgeKind) -> Vec<String> {
+        g.edges()
+            .iter()
+            .filter(|e| e.kind == kind)
+            .map(|e| match g.nodes().get(&e.from) {
+                Some(Node::Place(PlaceNode::Remote { arg_index, .. })) => format!("arg{arg_index}"),
+                Some(Node::Place(PlaceNode::Local { id, name, .. })) => {
+                    format!("{name}#{}", id.0)
+                }
+                other => panic!("unexpected node {other:?}"),
+            })
+            .collect()
+    }
+
+    fn both(body: TirExpr) -> [CapabilityGraph; 2] {
+        let f = func(body);
+        [derive_tcap(&f), BorrowingDeriver::new().derive(&f)]
+    }
+
+    #[test]
+    fn param_reads_target_their_own_remote() {
+        for g in both(add(add(var("c"), var("a")), var("b"))) {
+            assert_eq!(touched(&g, EdgeKind::Read), ["arg2", "arg0", "arg1"]);
+        }
+    }
+
+    #[test]
+    fn nested_let_shadowing_selects_innermost() {
+        // let x = a in ((x + (let x = b in x)) + x)
+        let body = let_(
+            "x",
+            var("a"),
+            add(add(var("x"), let_("x", var("b"), var("x"))), var("x")),
+        );
+        for g in both(body) {
+            // Params occupy places 1..=3; outer x is #4, inner x is #5.
+            assert_eq!(
+                touched(&g, EdgeKind::Read),
+                ["arg0", "x#4", "arg1", "x#5", "x#4"]
+            );
+        }
+    }
+
+    #[test]
+    fn let_init_sees_param_being_shadowed() {
+        // let a = a in a: init reads the parameter, body reads the local.
+        for g in both(let_("a", var("a"), var("a"))) {
+            assert_eq!(touched(&g, EdgeKind::Read), ["arg0", "a#4"]);
+        }
+    }
+
+    #[test]
+    fn locals_drop_at_scope_exit() {
+        // let x = a in ((let y = b in y) + x)
+        let body = let_("x", var("a"), add(let_("y", var("b"), var("y")), var("x")));
+        for g in both(body) {
+            assert_eq!(touched(&g, EdgeKind::Drop), ["y#5", "x#4"]);
+            assert_eq!(touched(&g, EdgeKind::Read), ["arg0", "arg1", "y#5", "x#4"]);
+        }
+    }
+}
