+/// Name resolution shared by both derivers: parameters are `Remote` places
+/// keyed by name, `let` binders form a stack so the innermost one wins.
+#[derive(Default)]
+struct Scope {
+    params: Vec<(String, PlaceId)>,
+    locals: Vec<(String, PlaceId)>,
+}
+
+impl Scope {
+    fn resolve(&self, name: &str) -> Option<PlaceId> {
+        self.locals
+            .iter()
+            .rev()
+            .find(|(n, _)| n == name)
+            .or_else(|| self.params.iter().find(|(n, _)| n == name))
+            .map(|(_, id)| *id)
+    }
+}
