+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::graph::Node;
+    use crate::lattice::Capability;
+    use tessera_tir::TirParam;
+
+    fn var(name: &str) -> TirExpr {
+        TirExpr::Var {
+            name: name.to_string(),
+            ty: TirType::I64,
+        }
+    }
+
+    fn int(value: i64) -> TirExpr {
+        TirExpr::Int {
+            value,
+            ty: TirType::I64,
+        }
+    }
+
+    fn add(lhs: TirExpr, rhs: TirExpr) -> TirExpr {
+        TirExpr::Add {
+            lhs: Box::new(lhs),
+            rhs: Box::new(rhs),
+            ty: TirType::I64,
+        }
+    }
+
+    fn let_(name: &str, init: TirExpr, body: TirExpr) -> TirExpr {
+        TirExpr::Let {
+            name: name.to_string(),
+            ty: TirType::I64,
+            init: Box::new(init),
+            body: Box::new(body),
+        }
+    }
+
+    fn func(params: &[&str], body: TirExpr) -> TirFunction {
+        TirFunction {
+            name: "f".to_string(),
+            params: params
+                .iter()
+                .map(|p| TirParam {
+                    name: (*p).to_string(),
+                    ty: TirType::I64,
+                })
+                .collect(),
+            ret: TirType::I64,
+            body,
+        }
+    }
+
+    /// `kind place` per edge in order; places print as `arg#i` or `name@id`
+    /// so shadowed locals with the same name stay distinguishable.
+    fn trace(graph: &CapabilityGraph) -> Vec<String> {
+        graph
+            .edges()
+            .iter()
+            .map(|edge| {
+                let place = match graph.nodes().get(&edge.from) {
+                    Some(Node::Place(PlaceNode::Remote { arg_index, .. })) => {
+                        format!("arg#{arg_index}")
+                    }
+                    Some(Node::Place(PlaceNode::Local { id, name, .. })) => {
+                        format!("{name}@{}", id.0)
+                    }
+                    other => panic!("unexpected edge source {other:?}"),
+                };
+                format!("{} {place}", edge.kind)
+            })
+            .collect()
+    }
+
+    /// Derive with both paths, assert they agree, and return the trace.
+    fn derive_both(f: &TirFunction) -> Vec<String> {
+        let plain = trace(&derive_tcap(f));
+        let borrowing = trace(&BorrowingDeriver::new().derive(f));
+        assert_eq!(plain, borrowing, "derivation paths disagree");
+        plain
+    }
+
+    #[test]
+    fn each_param_read_targets_its_own_remote() {
+        let f = func(&["a", "b", "c"], add(var("c"), add(var("a"), var("b"))));
+        assert_eq!(derive_both(&f), ["read arg#2", "read arg#0", "read arg#1"]);
+    }
+
+    #[test]
+    fn nested_let_shadowing_selects_innermost_place() {
+        // fn f(x) = let x = x + 1 in let x = x + 2 in x
+        let f = func(
+            &["x"],
+            let_(
+                "x",
+                add(var("x"), int(1)),
+                let_("x", add(var("x"), int(2)), var("x")),
+            ),
+        );
+        assert_eq!(
+            derive_both(&f),
+            ["read arg#0", "read x@2", "read x@3", "drop x@3", "drop x@2"]
+        );
+    }
+
+    #[test]
+    fn local_drops_at_scope_exit_and_param_is_visible_again() {
+        // fn f(a, b) = (let a = b in a) + a
+        let f = func(&["a", "b"], add(let_("a", var("b"), var("a")), var("a")));
+        assert_eq!(
+            derive_both(&f),
+            ["read arg#1", "read a@3", "drop a@3", "read arg#0"]
+        );
+    }
+
+    #[test]
+    fn sibling_lets_get_distinct_places_dropped_in_order() {
+        // fn f() = (let t = 1 in t) + (let t = 2 in t)
+        let f = func(
+            &[],
+            add(let_("t", int(1), var("t")), let_("t", int(2), var("t"))),
+        );
+        assert_eq!(
+            derive_both(&f),
+            ["read t@1", "drop t@1", "read t@2", "drop t@2"]
+        );
+    }
+
+    #[test]
+    fn final_states_params_kept_locals_dropped() {
+        let f = func(&["p"], let_("l", var("p"), var("l")));
+        for graph in [derive_tcap(&f), BorrowingDeriver::new().derive(&f)] {
+            assert_eq!(
+                graph.state(PlaceId(1)).map(|s| s.capability),
+                Some(Capability::Exclusive)
+            );
+            assert_eq!(
+                graph.state(PlaceId(2)).map(|s| s.capability),
+                Some(Capability::None)
+            );
+        }
+    }
+}
