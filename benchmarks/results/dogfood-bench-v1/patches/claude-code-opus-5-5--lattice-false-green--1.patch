+# check <name> <success message> <command...>: run one example, record the outcome.
+check() {
+  local name="$1" message="$2" status=0
+  shift 2
+  info "$name"
+  "$@" >/dev/null || status=$?
+  if [ "$status" -eq 0 ]; then
+    ok "$message"
+  else
+    printf '  \033[31m✗\033[0m %s (exit %s)\n' "$name" "$status" >&2
+    FAILED+=("$name")
+  fi
+}
 
