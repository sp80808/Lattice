+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::graph::EdgeKind;
+    use tessera_tir::TirParam;
+
+    fn var(name: &str) -> TirExpr {
+        TirExpr::Var {
+            name: name.into(),
+            ty: TirType::I64,
+        }
+    }
+
+    fn int(value: i64) -> TirExpr {
+        TirExpr::Int { value, ty: TirType::I64 }
+    }
+
+    fn let_(name: &str, init: TirExpr, body: TirExpr) -> TirExpr {
+        TirExpr::Let {
+            name: name.into(),
+            ty: TirType::I64,
+            init: Box::new(init),
+            body: Box::new(body),
+        }
+    }
+
+    fn add(lhs: TirExpr, rhs: TirExpr) -> TirExpr {
+        TirExpr::Add {
+            lhs: Box::new(lhs),
+            rhs: Box::new(rhs),
+            ty: TirType::I64,
+        }
+    }
+
+    fn func(params: &[&str], body: TirExpr) -> TirFunction {
+        TirFunction {
+            name: "f".into(),
+            params: params
+                .iter()
+                .map(|n| TirParam {
+                    name: (*n).into(),
+                    ty: TirType::I64,
+                })
+                .collect(),
+            ret: TirType::I64,
+            body,
+        }
+    }
+
+    fn place_of(g: &CapabilityGraph, edge: &crate::graph::Edge) -> PlaceNode {
+        match g.nodes().get(&edge.from) {
+            Some(crate::graph::Node::Place(p)) => p.clone(),
+            other => panic!("edge not on a place: {other:?}"),
+        }
+    }
+
+    /// (kind, tir_op, place description) per edge, in order.
+    fn trace(g: &CapabilityGraph) -> Vec<(EdgeKind, String, String)> {
+        g.edges()
+            .iter()
+            .map(|e| (e.kind, e.tir_op.clone(), place_of(g, e).to_string()))
+            .collect()
+    }
+
+    fn both(f: &TirFunction) -> [CapabilityGraph; 2] {
+        [derive_tcap(f), BorrowingDeriver::new().derive(f)]
+    }
+
+    #[test]
+    fn each_param_read_targets_its_own_remote() {
+        let f = func(&["a", "b", "c"], add(add(var("c"), var("a")), var("b")));
+        for g in both(&f) {
+            let reads: Vec<String> = trace(&g)
+                .into_iter()
+                .filter(|(k, ..)| *k == EdgeKind::Read)
+                .map(|(_, _, p)| p)
+                .collect();
+            assert_eq!(
+                reads,
+                ["remote arg#2", "remote arg#0", "remote arg#1"],
+                "reads must follow binder names"
+            );
+        }
+    }
+
+    #[test]
+    fn nested_let_shadowing_selects_innermost() {
+        // let x = a in (let x = x in x) + x
+        let body = let_(
+            "x",
+            var("a"),
+            add(let_("x", var("x"), var("x")), var("x")),
+        );
+        let f = func(&["a"], body);
+        for g in both(&f) {
+            let t = trace(&g);
+            let ops: Vec<_> = t.iter().map(|(k, o, p)| (*k, o.as_str(), p.as_str())).collect();
+            assert_eq!(ops.len(), 6, "{ops:?}");
+            assert_eq!(ops[0], (EdgeKind::Read, "read a", "remote arg#0"));
+            // inner init reads outer x, inner body reads inner x
+            let ids: Vec<_> = g
+                .edges()
+                .iter()
+                .map(|e| place_of(&g, e).id())
+                .collect();
+            assert_eq!(ids[1], ids[4], "inner init and trailing read hit outer x");
+            assert_ne!(ids[1], ids[2], "inner body must read the inner x");
+            assert_eq!(ids[2], ids[3], "inner x read then dropped");
+            assert_eq!(ids[4], ids[5], "outer x dropped last");
+            assert_eq!(ops[3].0, EdgeKind::Drop);
+            assert_eq!(ops[5].0, EdgeKind::Drop);
+        }
+    }
+
+    #[test]
+    fn local_shadows_param_and_drops_at_scope_exit() {
+        // (let a = 1 in a) + a : second read must hit the param again
+        let f = func(&["a"], add(let_("a", int(1), var("a")), var("a")));
+        for g in both(&f) {
+            let t = trace(&g);
+            assert_eq!(t.len(), 3);
+            assert_eq!(t[0].1, "read a");
+            assert!(t[0].2.starts_with("local"), "{:?}", t[0]);
+            assert_eq!(t[1].0, EdgeKind::Drop);
+            assert_eq!(t[1].2, t[0].2);
+            assert_eq!(t[2], (EdgeKind::Read, "read a".into(), "remote arg#0".into()));
+        }
+    }
+
+    #[test]
+    fn derivers_agree() {
+        let f = func(
+            &["p", "q"],
+            let_("t", var("q"), add(var("t"), let_("p", var("p"), var("p")))),
+        );
+        let [a, b] = both(&f);
+        assert_eq!(trace(&a), trace(&b));
+    }
+}
