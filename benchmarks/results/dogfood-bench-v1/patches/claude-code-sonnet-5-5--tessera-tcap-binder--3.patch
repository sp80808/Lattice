+/// Name resolution shared by both derivers so they agree on binder rules:
+/// innermost `let` wins, then parameters by name.
+#[derive(Default)]
+struct Binders {
+    params: Vec<(String, PlaceId)>,
+    lets: Vec<(String, PlaceId)>,
+}
+
+impl Binders {
+    fn resolve(&self, name: &str) -> Option<PlaceId> {
+        self.lets
+            .iter()
+            .rev()
+            .chain(self.params.iter().rev())
+            .find(|(n, _)| n == name)
+            .map(|(_, id)| *id)
+    }
+}
+
+fn place_type(ty: TirType) -> PlaceType {
+    match ty {
+        TirType::I64 | TirType::Bool => PlaceType::Scalar,
+    }
+}
