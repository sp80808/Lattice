@@ -0,0 +1,188 @@
+//! Locks TCap derivation rules for variable reads, shadowing, and scope-exit drops.
+//!
+//! Each trace line is `<edge kind> <place> <place id>`, in graph edge order.
+//! Place ids are assigned in creation order: parameters first, then `Let`
+//! binders as they are entered.
+
+use tessera_tcap::derive::{BorrowingDeriver, derive_tcap};
+use tessera_tcap::graph::{CapabilityGraph, Node};
+use tessera_tir::{TirExpr, TirFunction, TirParam, TirType};
+
+fn var(name: &str) -> TirExpr {
+    TirExpr::Var {
+        name: name.to_string(),
+        ty: TirType::I64,
+    }
+}
+
+fn int(value: i64) -> TirExpr {
+    TirExpr::Int {
+        value,
+        ty: TirType::I64,
+    }
+}
+
+fn add(lhs: TirExpr, rhs: TirExpr) -> TirExpr {
+    TirExpr::Add {
+        lhs: Box::new(lhs),
+        rhs: Box::new(rhs),
+        ty: TirType::I64,
+    }
+}
+
+fn let_in(name: &str, init: TirExpr, body: TirExpr) -> TirExpr {
+    TirExpr::Let {
+        name: name.to_string(),
+        ty: TirType::I64,
+        init: Box::new(init),
+        body: Box::new(body),
+    }
+}
+
+fn func(params: &[&str], body: TirExpr) -> TirFunction {
+    TirFunction {
+        name: "f".to_string(),
+        params: params
+            .iter()
+            .map(|p| TirParam {
+                name: (*p).to_string(),
+                ty: TirType::I64,
+            })
+            .collect(),
+        ret: TirType::I64,
+        body,
+    }
+}
+
+fn trace(graph: &CapabilityGraph) -> Vec<String> {
+    graph
+        .edges()
+        .iter()
+        .map(|edge| {
+            let Some(Node::Place(place)) = graph.nodes().get(&edge.from) else {
+                panic!("edge {:?} does not start at a place node", edge.id);
+            };
+            format!("{} {} {}", edge.kind, place, place.id())
+        })
+        .collect()
+}
+
+fn assert_trace(graph: &CapabilityGraph, expected: &[&str]) {
+    assert_eq!(trace(graph), expected);
+}
+
+/// Both derivation paths must produce the same trace for the same function.
+fn derive_both(f: &TirFunction) -> (CapabilityGraph, CapabilityGraph) {
+    (derive_tcap(f), BorrowingDeriver::new().derive(f))
+}
+
+#[test]
+fn parameter_reads_target_their_own_remote_place() {
+    // fn f(a, b) = b + a
+    let f = func(&["a", "b"], add(var("b"), var("a")));
+    let (tcap, borrowing) = derive_both(&f);
+
+    let expected = ["read remote arg#1 @2", "read remote arg#0 @1"];
+    assert_trace(&tcap, &expected);
+    assert_trace(&borrowing, &expected);
+}
+
+#[test]
+fn parameter_reads_resolve_by_name_not_position() {
+    // fn f(a, b, c) = c + a + c: every read must hit a different place
+    // depending on the name, never a fixed positional fallback.
+    let f = func(&["a", "b", "c"], add(add(var("c"), var("a")), var("c")));
+    let (tcap, borrowing) = derive_both(&f);
+
+    let expected = [
+        "read remote arg#2 @3",
+        "read remote arg#0 @1",
+        "read remote arg#2 @3",
+    ];
+    assert_trace(&tcap, &expected);
+    assert_trace(&borrowing, &expected);
+}
+
+#[test]
+fn let_init_sees_outer_binder_and_body_sees_new_one() {
+    // fn f(x) = let x = x in x
+    let f = func(&["x"], let_in("x", var("x"), var("x")));
+    let (tcap, borrowing) = derive_both(&f);
+
+    // init reads the parameter; body reads the new local; local drops on exit.
+    let expected = ["read remote arg#0 @1", "read local x @2", "drop local x @2"];
+    assert_trace(&tcap, &expected);
+    assert_trace(&borrowing, &expected);
+}
+
+#[test]
+fn nested_let_shadowing_selects_innermost_place_and_drops_in_order() {
+    // let x = 1 in ((let x = x + 1 in x) + x)
+    let f = func(
+        &[],
+        let_in(
+            "x",
+            int(1),
+            add(let_in("x", add(var("x"), int(1)), var("x")), var("x")),
+        ),
+    );
+    let (tcap, borrowing) = derive_both(&f);
+
+    let expected = [
+        // inner init reads outer x (@1)
+        "read local x @1",
+        // inner body reads inner x (@2)
+        "read local x @2",
+        // inner scope exit
+        "drop local x @2",
+        // after the inner let, x resolves to the outer binder again
+        "read local x @1",
+        // outer scope exit
+        "drop local x @1",
+    ];
+    assert_trace(&tcap, &expected);
+    assert_trace(&borrowing, &expected);
+}
+
+#[test]
+fn let_binder_shadows_parameter_of_same_name() {
+    // fn f(a, b) = let a = b in a
+    let f = func(&["a", "b"], let_in("a", var("b"), var("a")));
+    let (tcap, borrowing) = derive_both(&f);
+
+    let expected = ["read remote arg#1 @2", "read local a @3", "drop local a @3"];
+    assert_trace(&tcap, &expected);
+    assert_trace(&borrowing, &expected);
+}
+
+#[test]
+fn locals_drop_at_their_scope_exit_not_at_function_end() {
+    // fn f(a) = (let y = 0 in y) + a
+    let f = func(&["a"], add(let_in("y", int(0), var("y")), var("a")));
+    let (tcap, borrowing) = derive_both(&f);
+
+    // `y` is dropped before the read of `a`, which happens after its scope.
+    let expected = ["read local y @2", "drop local y @2", "read remote arg#0 @1"];
+    assert_trace(&tcap, &expected);
+    assert_trace(&borrowing, &expected);
+}
+
+#[test]
+fn borrowing_deriver_agrees_with_tcap_deriver_on_sibling_lets() {
+    // (let x = 1 in x) + (let x = 2 in x): two distinct `x` places, each dropped
+    // at its own scope exit.
+    let f = func(
+        &[],
+        add(let_in("x", int(1), var("x")), let_in("x", int(2), var("x"))),
+    );
+    let (tcap, borrowing) = derive_both(&f);
+
+    let expected = [
+        "read local x @1",
+        "drop local x @1",
+        "read local x @2",
+        "drop local x @2",
+    ];
+    assert_trace(&tcap, &expected);
+    assert_trace(&borrowing, &expected);
+}
