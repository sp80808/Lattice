diff --git a/scripts/check-examples.sh b/scripts/check-examples.sh
old mode 100644
new mode 100755
index 3da19b8..37edd55
--- a/scripts/check-examples.sh
+++ b/scripts/check-examples.sh
@@ -1,5 +1,9 @@
 #!/usr/bin/env bash
 # Run every offline example and validate every example config. Used by CI.
+#
+# Exit status is the verdict: any failing example makes the whole run fail, and
+# a skipped example also fails unless it is named in LATTICE_EXAMPLES_ALLOW_SKIP
+# (comma-separated, e.g. LATTICE_EXAMPLES_ALLOW_SKIP=python).
 set -euo pipefail
 . "$(dirname "$0")/lib.sh"
 
@@ -7,8 +11,51 @@ require_node
 require_built_cli
 cd "$LATTICE_ROOT"
 
+FAILED=()
+ALLOW_SKIP=",${LATTICE_EXAMPLES_ALLOW_SKIP:-},"
+
+# example LABEL COMMAND...: run one check; its output is shown only on failure.
+example() {
+  local label="$1" out status=0
+  shift
+  info "$label"
+  out="$("$@" 2>&1)" || status=$?
+  if [ "$status" -eq 0 ]; then
+    ok "passed"
+  else
+    printf '%s\n' "$out" >&2
+    printf '  \033[31m✗\033[0m %s exited %s\n' "$label" "$status" >&2
+    FAILED+=("$label")
+  fi
+}
+
+# expect_failure LABEL COMMAND...: a deliberately broken fixture must exit non-zero.
+expect_failure() {
+  local label="$1" status=0
+  shift
+  info "$label (must fail)"
+  "$@" >/dev/null 2>&1 || status=$?
+  if [ "$status" -ne 0 ]; then
+    ok "exited $status, as intended"
+  else
+    printf '  \033[31m✗\033[0m %s unexpectedly passed\n' "$label" >&2
+    FAILED+=("$label")
+  fi
+}
+
+# skip NAME REASON: a skipped check is a failure unless explicitly allow-listed.
+skip() {
+  local name="$1" reason="$2"
+  if [[ "$ALLOW_SKIP" == *",$name,"* ]]; then
+    warn "$name skipped ($reason); allowed by LATTICE_EXAMPLES_ALLOW_SKIP"
+  else
+    printf '  \033[31m✗\033[0m %s skipped (%s); set LATTICE_EXAMPLES_ALLOW_SKIP=%s to allow\n' "$name" "$reason" "$name" >&2
+    FAILED+=("$name (skipped)")
+  fi
+}
+
 info "Validating examples/configs/*.json"
-node --input-type=module -e '
+example "example configs parse" node --input-type=module -e '
   import { readdirSync, readFileSync } from "node:fs";
   import { parseLatticeConfig } from "@lattice/runtime";
   for (const name of readdirSync("examples/configs").filter((f) => f.endsWith(".json") && !f.startsWith("."))) {
@@ -17,26 +64,22 @@ node --input-type=module -e '
   }
 '
 
-info "examples/embedded/offline-search-loop.mjs"
-node examples/embedded/offline-search-loop.mjs >/dev/null && ok "search solved by test evidence"
+expect_failure "examples/demo-repo (intentionally broken: add subtracts)" \
+  npm --prefix examples/demo-repo test
 
-info "examples/sdk/typescript/run-and-inspect.mjs"
-env -u LATTICE_URL node examples/sdk/typescript/run-and-inspect.mjs >/dev/null && ok "TypeScript SDK round-trip"
-
-info "examples/review/remote-reviewer.mjs"
-node examples/review/remote-reviewer.mjs >/dev/null && ok "remote review of an auto-mode run"
-
-info "examples/mcp/raw-session.mjs"
-node examples/mcp/raw-session.mjs >/dev/null && ok "MCP stdio session"
-
-info "examples/demo/run-demo.sh"
-examples/demo/run-demo.sh >/dev/null && ok "CLI walkthrough"
+example "examples/embedded/offline-search-loop.mjs" node examples/embedded/offline-search-loop.mjs
+example "examples/sdk/typescript/run-and-inspect.mjs" env -u LATTICE_URL node examples/sdk/typescript/run-and-inspect.mjs
+example "examples/review/remote-reviewer.mjs" node examples/review/remote-reviewer.mjs
+example "examples/mcp/raw-session.mjs" node examples/mcp/raw-session.mjs
+example "examples/demo/run-demo.sh" bash examples/demo/run-demo.sh
 
 if has python3; then
-  info "examples/sdk/python/run_and_inspect.py"
-  env -u LATTICE_URL python3 examples/sdk/python/run_and_inspect.py >/dev/null && ok "Python SDK round-trip"
+  example "examples/sdk/python/run_and_inspect.py" env -u LATTICE_URL python3 examples/sdk/python/run_and_inspect.py
 else
-  warn "python3 not found; skipping the Python SDK example"
+  skip python "python3 not found"
 fi
 
+if [ "${#FAILED[@]}" -gt 0 ]; then
+  die "examples failed: $(IFS=', '; echo "${FAILED[*]}")"
+fi
 info "All examples passed"
