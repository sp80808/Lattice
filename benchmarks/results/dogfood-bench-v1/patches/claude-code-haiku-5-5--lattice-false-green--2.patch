 NODE = shutil.which("node")
 
+# A missing daemon is a failure, not a silent skip. Opt out explicitly with
+# LATTICE_TESTS_ALLOW_SKIP=daemon (comma-separated list).
+ALLOWED_SKIPS = {name for name in os.environ.get("LATTICE_TESTS_ALLOW_SKIP", "").split(",") if name}
+if not (NODE and CLI.exists()) and "daemon" not in ALLOWED_SKIPS:
+    raise RuntimeError(
+        "node and a built CLI (npm run build) are required; "
+        "set LATTICE_TESTS_ALLOW_SKIP=daemon to skip the daemon integration tests"
+    )
 
-@unittest.skipUnless(NODE and CLI.exists(), "node and a built CLI (npm run build) are required")
