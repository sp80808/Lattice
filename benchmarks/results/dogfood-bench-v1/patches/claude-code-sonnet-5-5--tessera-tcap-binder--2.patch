@@ -0,0 +1,153 @@
+//! Locks name resolution, shadowing and scope-exit drops for both derivers.
+
+use tessera_tcap::derive::BorrowingDeriver;
+use tessera_tcap::lattice::PlaceId;
+use tessera_tcap::{CapabilityGraph, EdgeKind, PlaceNode, derive_tcap};
+use tessera_tir::{TirExpr, TirFunction, TirParam, TirType};
+
+fn var(name: &str) -> TirExpr {
+    TirExpr::Var {
+        name: name.into(),
+        ty: TirType::I64,
+    }
+}
+
+fn add(lhs: TirExpr, rhs: TirExpr) -> TirExpr {
+    TirExpr::Add {
+        lhs: Box::new(lhs),
+        rhs: Box::new(rhs),
+        ty: TirType::I64,
+    }
+}
+
+fn let_(name: &str, init: TirExpr, body: TirExpr) -> TirExpr {
+    TirExpr::Let {
+        name: name.into(),
+        ty: TirType::I64,
+        init: Box::new(init),
+        body: Box::new(body),
+    }
+}
+
+fn func(params: &[&str], body: TirExpr) -> TirFunction {
+    TirFunction {
+        name: "f".into(),
+        params: params
+            .iter()
+            .map(|p| TirParam {
+                name: (*p).into(),
+                ty: TirType::I64,
+            })
+            .collect(),
+        ret: TirType::I64,
+        body,
+    }
+}
+
+/// `(kind, tir_op, place)` for each read/drop edge in order.
+fn trace(g: &CapabilityGraph) -> Vec<(EdgeKind, String, PlaceId)> {
+    g.edges()
+        .iter()
+        .map(|e| {
+            let place = g.nodes()[&e.from].place_id().expect("place edge");
+            (e.kind, e.tir_op.clone(), place)
+        })
+        .collect()
+}
+
+fn derivations(f: &TirFunction) -> [CapabilityGraph; 2] {
+    [derive_tcap(f), BorrowingDeriver::new().derive(f)]
+}
+
+fn arg_place(g: &CapabilityGraph, idx: usize) -> PlaceId {
+    g.places()
+        .find_map(|p| match p {
+            PlaceNode::Remote { id, arg_index, .. } if *arg_index == idx => Some(*id),
+            _ => None,
+        })
+        .expect("remote place")
+}
+
+#[test]
+fn each_param_read_targets_its_own_remote() {
+    let f = func(&["a", "b", "c"], add(add(var("c"), var("a")), var("b")));
+    for g in derivations(&f) {
+        let reads: Vec<_> = trace(&g)
+            .into_iter()
+            .filter(|(k, ..)| *k == EdgeKind::Read)
+            .collect();
+        assert_eq!(
+            reads.iter().map(|r| r.2).collect::<Vec<_>>(),
+            vec![arg_place(&g, 2), arg_place(&g, 0), arg_place(&g, 1)]
+        );
+        assert_eq!(g.places().count(), 3, "no extra places invented");
+    }
+}
+
+#[test]
+fn nested_let_shadowing_selects_innermost() {
+    // x param; let x = x in let x = x in x
+    let f = func(&["x"], let_("x", var("x"), let_("x", var("x"), var("x"))));
+    for g in derivations(&f) {
+        let t = trace(&g);
+        let mut locals: Vec<PlaceId> = g
+            .places()
+            .filter_map(|p| match p {
+                PlaceNode::Local { id, .. } => Some(*id),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(locals.len(), 2);
+        locals.sort_by_key(|p| p.0);
+        let (outer, inner) = (locals[0], locals[1]);
+        let reads: Vec<_> = t
+            .iter()
+            .filter(|(k, ..)| *k == EdgeKind::Read)
+            .map(|r| r.2)
+            .collect();
+        // init of outer -> param, init of inner -> outer, body -> inner
+        assert_eq!(reads, vec![arg_place(&g, 0), outer, inner]);
+    }
+}
+
+#[test]
+fn shadow_ends_at_scope_exit_and_locals_drop_there() {
+    // (x + (let x = 1 in x)) + x : last x is the param again.
+    let inner = let_(
+        "x",
+        TirExpr::Int {
+            value: 1,
+            ty: TirType::I64,
+        },
+        var("x"),
+    );
+    let f = func(&["x"], add(add(var("x"), inner), var("x")));
+    for g in derivations(&f) {
+        let t = trace(&g);
+        let kinds: Vec<_> = t.iter().map(|(k, ..)| *k).collect();
+        assert_eq!(
+            kinds,
+            vec![
+                EdgeKind::Read,
+                EdgeKind::Read,
+                EdgeKind::Drop,
+                EdgeKind::Read
+            ]
+        );
+        let param = arg_place(&g, 0);
+        assert_eq!(t[0].2, param);
+        assert_ne!(t[1].2, param);
+        assert_eq!(t[2].2, t[1].2, "local dropped right after its body");
+        assert_eq!(t[3].2, param);
+    }
+}
+
+#[test]
+fn derivers_agree() {
+    let f = func(
+        &["a", "b"],
+        let_("a", var("b"), add(var("a"), let_("b", var("a"), var("b")))),
+    );
+    let [a, b] = derivations(&f);
+    assert_eq!(trace(&a), trace(&b));
+}
