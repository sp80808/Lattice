+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::graph::{EdgeKind, Node};
+    use crate::lattice::Capability;
+    use tessera_tir::TirParam;
+
+    fn var(name: &str) -> TirExpr {
+        TirExpr::Var {
+            name: name.to_string(),
+            ty: TirType::I64,
+        }
+    }
+
+    fn add(lhs: TirExpr, rhs: TirExpr) -> TirExpr {
+        TirExpr::Add {
+            lhs: Box::new(lhs),
+            rhs: Box::new(rhs),
+            ty: TirType::I64,
+        }
+    }
+
+    fn let_(name: &str, init: TirExpr, body: TirExpr) -> TirExpr {
+        TirExpr::Let {
+            name: name.to_string(),
+            ty: TirType::I64,
+            init: Box::new(init),
+            body: Box::new(body),
+        }
+    }
+
+    fn int(value: i64) -> TirExpr {
+        TirExpr::Int {
+            value,
+            ty: TirType::I64,
+        }
+    }
+
+    fn func(params: &[&str], body: TirExpr) -> TirFunction {
+        TirFunction {
+            name: "f".to_string(),
+            params: params
+                .iter()
+                .map(|name| TirParam {
+                    name: (*name).to_string(),
+                    ty: TirType::I64,
+                })
+                .collect(),
+            ret: TirType::I64,
+            body,
+        }
+    }
+
+    /// Stable rendering of a place: `arg#N` for remotes, `name@id` for locals.
+    fn render(graph: &CapabilityGraph, node: crate::graph::NodeId) -> String {
+        match graph.nodes().get(&node) {
+            Some(Node::Place(PlaceNode::Remote { arg_index, .. })) => format!("arg#{arg_index}"),
+            Some(Node::Place(PlaceNode::Local { id, name, .. })) => format!("{name}@{}", id.0),
+            other => panic!("edge targets non-place node {other:?}"),
+        }
+    }
+
+    /// Deterministic `kind target` trace of every edge in emission order.
+    fn trace(graph: &CapabilityGraph) -> Vec<String> {
+        graph
+            .edges()
+            .iter()
+            .map(|e| {
+                assert_eq!(e.from, e.to, "read/drop edges are self-loops");
+                format!("{} {}", e.kind, render(graph, e.from))
+            })
+            .collect()
+    }
+
+    fn both(f: &TirFunction) -> Vec<String> {
+        let plain = trace(&derive_tcap(f));
+        let borrowing = trace(&BorrowingDeriver::new().derive(f));
+        assert_eq!(plain, borrowing, "derivation paths disagree");
+        plain
+    }
+
+    #[test]
+    fn each_param_read_targets_its_own_remote() {
+        let f = func(&["a", "b", "c"], add(add(var("c"), var("a")), var("b")));
+        assert_eq!(both(&f), ["read arg#2", "read arg#0", "read arg#1"]);
+    }
+
+    #[test]
+    fn param_reads_have_no_edges_to_other_params() {
+        let f = func(&["a", "b"], var("b"));
+        assert_eq!(both(&f), ["read arg#1"]);
+    }
+
+    #[test]
+    fn let_shadowing_param_reads_local_then_param_after_scope() {
+        // let a = a + 1 in a ; then the outer `b` reads b.
+        let f = func(
+            &["a", "b"],
+            add(let_("a", add(var("a"), int(1)), var("a")), var("b")),
+        );
+        assert_eq!(
+            both(&f),
+            ["read arg#0", "read a@3", "drop a@3", "read arg#1"]
+        );
+    }
+
+    #[test]
+    fn nested_let_shadowing_selects_innermost_and_drops_inside_out() {
+        // let x = 1 in (let x = x in x) + x
+        let f = func(
+            &[],
+            let_("x", int(1), add(let_("x", var("x"), var("x")), var("x"))),
+        );
+        assert_eq!(
+            both(&f),
+            ["read x@1", "read x@2", "drop x@2", "read x@1", "drop x@1"]
+        );
+    }
+
+    #[test]
+    fn locals_drop_at_their_let_exit_not_function_end() {
+        // (let t = p in t) + p
+        let f = func(&["p"], add(let_("t", var("p"), var("t")), var("p")));
+        let graph = derive_tcap(&f);
+        assert_eq!(
+            both(&f),
+            ["read arg#0", "read t@2", "drop t@2", "read arg#0"]
+        );
+        assert_eq!(
+            graph.state(PlaceId(2)).map(|s| s.capability),
+            Some(Capability::None)
+        );
+        assert_eq!(
+            graph.state(PlaceId(1)).map(|s| s.capability),
+            Some(Capability::Exclusive)
+        );
+        assert_eq!(
+            graph
+                .edges()
+                .iter()
+                .filter(|e| e.kind == EdgeKind::Drop)
+                .count(),
+            1
+        );
+    }
+
+    #[test]
+    fn derivation_is_deterministic() {
+        let f = func(
+            &["a", "b"],
+            let_("a", var("b"), let_("b", var("a"), add(var("a"), var("b")))),
+        );
+        let first = both(&f);
+        for _ in 0..8 {
+            assert_eq!(both(&f), first);
+        }
+        assert_eq!(
+            first,
+            [
+                "read arg#1",
+                "read a@3",
+                "read a@3",
+                "read b@4",
+                "drop b@4",
+                "drop a@3"
+            ]
+        );
+    }
+}
